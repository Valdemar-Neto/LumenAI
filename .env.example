# Qual provedor de inferencia usar: "huggingface" (router.huggingface.co, cota
# de creditos da HF compartilhada entre todos os modelos/provedores) ou "groq"
# (api.groq.com direto, cota/plano da propria conta Groq).
INFERENCE_PROVIDER=huggingface

# --- usado quando INFERENCE_PROVIDER=huggingface ---
# Token da Hugging Face com permissao "Make calls to Inference Providers"
# Crie em: https://huggingface.co/settings/tokens/new?ownUserPermissions=inference.serverless.write&tokenType=fineGrained
HF_TOKEN=hf_coloque_seu_token_aqui

# --- usado quando INFERENCE_PROVIDER=groq ---
# Token da API da Groq (https://console.groq.com/keys)
GROQ_API_KEY=gsk_coloque_sua_chave_aqui

# Opcional: habilita busca na web no modo de chat geral (evita respostas
# inventadas sobre fatos atuais/especificos). Cadastro gratis, sem cartao, em
# https://tavily.com — 1000 buscas/mes no plano free.
TAVILY_API_KEY=tvly-coloque_sua_chave_aqui

# Modelo usado para gerar o site (precisa suportar tool/function calling).
# Com INFERENCE_PROVIDER=huggingface, verifique o campo "supports_tools" DO
# PROVEDOR em https://router.huggingface.co/v1/models antes de trocar — um
# modelo listado pode nao suportar tools no provedor escolhido e quebrar com
# erro 400/422. Use o sufixo ":provedor" para forcar um provedor especifico
# (ex: deepseek-ai/DeepSeek-V3.2:novita).
# Com INFERENCE_PROVIDER=groq, use o nome do modelo direto do catalogo da Groq
# (https://console.groq.com/docs/models), sem sufixo de provedor.
HF_MODEL=Qwen/Qwen3-Coder-480B-A35B-Instruct:novita

# Token do GitHub (classic ou fine-grained) com permissao de escrita (repo/contents) no repositorio alvo
GITHUB_TOKEN=ghp_coloque_seu_token_aqui

# Repositorio onde o site sera gerado, formato usuario/repositorio
GITHUB_REPO=seu-usuario/seu-repositorio

# Branch alvo (a mesma configurada no GitHub Pages)
GITHUB_BRANCH=main

# Autor dos commits gerados pelo agente
GIT_AUTHOR_NAME=Valdemar Goncalves Pereira Neto
GIT_AUTHOR_EMAIL=goncalvesvaldemar629@gmail.com

# Pasta local de trabalho (clone temporario do repositorio)
WORK_DIR=.workdir

# Numero maximo de passos do loop do agente antes de parar por seguranca
MAX_STEPS=25
